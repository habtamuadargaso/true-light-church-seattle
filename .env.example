# Resend Email API (optional — contact form will log to console without it)
RESEND_API_KEY=your_resend_api_key_here

# Where contact form emails should be sent
CONTACT_TO_EMAIL=pastor@truelightseattle.org

# Optional: your Resend domain
RESEND_FROM_EMAIL=noreply@truelightseattle.org

# Supabase (optional — the admin dashboard and admin-managed content are
# disabled without these, and the public site falls back to its static
# defaults/empty states). Find both values in your Supabase project under
# Project Settings > API. The anon key is safe to expose publicly — it is
# useless without the Row Level Security policies from
# supabase/migrations/, which this project relies on instead of a
# service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
